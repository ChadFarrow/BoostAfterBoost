# BoostAfterBoost Configuration
# IRC to Nostr bridge for BowlAfterBowl channel

# Required: Your BoostAfterBoost Nostr private key (nsec1 format)
NOSTR_NSEC=nsec1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Custom Nostr relays (comma-separated)
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://nostr.mom,wss://relay.primal.net

# IRC Configuration.
# In production IRC_SERVER is the ZNC container ("znc") on the compose bridge
# network, not ZeroNode directly -- ZNC multiplexes one ZeroNode connection across
# all three bots. Set IRC_PASSWORD to the clientid form so this bot is its own
# client on that shared connection:
#   IRC_PASSWORD=ircbots@bab/zeronode:<znc password>
IRC_SERVER=irc.zeronode.net
IRC_PORT=6667
IRC_SECURE=false
IRC_PASSWORD=
IRC_CHANNEL=#BowlAfterBowl
IRC_NICKNAME=BoostAfterBoost_Reader
IRC_USERNAME=boost_reader
IRC_REALNAME=BoostAfterBoost Reader Bot

# Target Bot to Monitor
TARGET_BOT=BoostAfterBoost

# Application Settings
PORT=3335
TEST_MODE=false

# How long to wait after an IRC line before deciding a message is complete. A long
# boost arrives as two or three lines and is rejoined into one Nostr note
# (lib/message-assembler.js); this is the idle gap that ends one. Raising it delays
# every post by that much, lowering it risks splitting a slow sender's message.
IRC_JOIN_WINDOW_MS=2500

# Podcast Index API — resolves a show name to its feed GUID and an episode title
# to its item GUID for NIP-73 tags. Optional: without these the bot still posts
# with the amount and boost topic tags, just without podcast:guid / item tags.
# https://api.podcastindex.org/signup
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# The IRC network these messages appeared on, used for the `r` provenance tag on
# each Nostr note. NOT the same as IRC_SERVER, which is the bouncer we read
# through (`znc` in the container, `localhost` on the old host) and resolves
# nowhere for anyone reading the note.
IRC_NETWORK_HOST=irc.zeronode.net
