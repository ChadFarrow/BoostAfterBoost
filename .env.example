# BoostAfterBoost Configuration
# IRC to Nostr bridge for BowlAfterBowl channel

# Required: Your BoostAfterBoost Nostr private key (nsec1 format)
NOSTR_NSEC=nsec1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Custom Nostr relays (comma-separated)
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://nostr.mom,wss://relay.primal.net

# IRC Configuration.
# In production IRC_SERVER is the ZNC container ("znc") on the compose bridge
# network, not ZeroNode directly -- ZNC multiplexes one ZeroNode connection across
# all three bots. Set IRC_PASSWORD to the clientid form so this bot is its own
# client on that shared connection:
#   IRC_PASSWORD=ircbots@bab/zeronode:<znc password>
IRC_SERVER=irc.zeronode.net
IRC_PORT=6667
IRC_SECURE=false
IRC_PASSWORD=
IRC_CHANNEL=#BowlAfterBowl
IRC_NICKNAME=BoostAfterBoost_Reader
IRC_USERNAME=boost_reader
IRC_REALNAME=BoostAfterBoost Reader Bot

# Target Bot to Monitor
TARGET_BOT=BoostAfterBoost

# Application Settings
PORT=3335
TEST_MODE=false

# Podcast Index API — resolves a show name to its feed GUID for NIP-73 tags.
# Optional: without these the bot still posts, just without podcast:guid tags.
# https://api.podcastindex.org/signup
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
